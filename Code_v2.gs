const SHEET_NAME="Reports";
function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
function setup(){let s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!s)s=SpreadsheetApp.getActiveSpreadsheet().insertSheet(SHEET_NAME);if(!s.getLastRow())s.appendRow(["rid","title","category","description","location","priority","status","userId","userName","date","time","assignedTo","history","notes"]);return "Ready";}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(10000);const p=JSON.parse(e.postData.contents||"{}");const secret=PropertiesService.getScriptProperties().getProperty("ADMIN_KEY");const admin=["list","update","assign","delete"].includes(p.action);if(admin&&(!secret||p.key!==secret))return out({ok:false,error:"Unauthorized"});const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!sh)throw Error("Run setup() first.");const values=sh.getDataRange().getValues(),h=values[0],ix=h.indexOf("rid");if(p.action==="list"){const reports=values.slice(1).filter(r=>r[ix]).map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);try{o.history=JSON.parse(o.history||"[]")}catch(_){o.history=[]}try{o.notes=JSON.parse(o.notes||"[]")}catch(_){o.notes=[]}return o});return out({ok:true,reports})}const n=values.findIndex((r,i)=>i>0&&String(r[ix])===String(p.rid));if(p.action==="create"){if(!p.rid||!p.title||!p.userId)throw Error("Missing required fields.");if(n>0)throw Error("Duplicate report ID.");sh.appendRow([p.rid,p.title,p.category,p.description,p.location,p.priority,p.status,p.userId,p.userName,p.date,p.time,p.assignedTo,JSON.stringify(p.history||[]),JSON.stringify(p.notes||[])]);return out({ok:true})}if(n<1)throw Error("Report not found.");const row=values[n];if(p.action==="update"){row[h.indexOf("status")]=p.status;const j=h.indexOf("history");let history=[];try{history=JSON.parse(row[j]||"[]")}catch(_){}history.push([p.status,new Date().toISOString()]);row[j]=JSON.stringify(history)}else if(p.action==="assign"){row[h.indexOf("assignedTo")]=p.assignedTo||""}else if(p.action==="delete"){sh.deleteRow(n+1);return out({ok:true})}else throw Error("Unknown action.");sh.getRange(n+1,1,1,h.length).setValues([row]);return out({ok:true})}catch(err){return out({ok:false,error:String(err)})}finally{try{lock.releaseLock()}catch(_){}}}
