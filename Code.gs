const SHEET_NAME = "Reports";
function json(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(["rid","title","category","description","location","priority","status","userId","userName","date","time","assignedTo","history","notes"]);return "Ready";}
function doGet(e){try{const key=PropertiesService.getScriptProperties().getProperty("ADMIN_KEY");if(!key||e.parameter.key!==key)return json({ok:false,error:"Unauthorized"});const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!sh)return json({ok:true,reports:[]});const rows=sh.getDataRange().getValues();if(rows.length<2)return json({ok:true,reports:[]});const headers=rows.shift();const reports=rows.filter(r=>r[0]).map(r=>{const o={};headers.forEach((h,i)=>o[h]=r[i]);try{o.history=JSON.parse(o.history||"[]");}catch(_){o.history=[];}try{o.notes=JSON.parse(o.notes||"[]");}catch(_){o.notes=[];}return o;});return json({ok:true,reports});}catch(err){return json({ok:false,error:String(err)});}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(10000);const p=JSON.parse(e.postData.contents||"{}");const key=PropertiesService.getScriptProperties().getProperty("ADMIN_KEY");const admin=["list","update","assign","delete"].includes(p.action);if(admin&&(!key||p.key!==key))return json({ok:false,error:"Unauthorized"});const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!sh)throw new Error("Run setup() first.");const vals=sh.getDataRange().getValues(),headers=vals[0],idx=headers.indexOf("rid");const rowIndex=vals.findIndex((r,i)=>i>0&&String(r[idx])===String(p.rid));if(p.action==="create"){if(!p.rid||!p.title||!p.userId)throw new Error("Missing required report fields.");if(rowIndex>=0)throw new Error("Duplicate report ID.");sh.appendRow([p.rid,p.title,p.category,p.description,p.location,p.priority,p.status,p.userId,p.userName,p.date,p.time,p.assignedTo,JSON.stringify(p.history||[]),JSON.stringify(p.notes||[])]);return json({ok:true});}if(p.action==="update"||p.action==="assign"){if(rowIndex<1)throw new Error("Report not found.");const row=vals[rowIndex];if(p.action==="update"){row[headers.indexOf("status")]=p.status;const h=headers.indexOf("history");let hist=[];try{hist=JSON.parse(row[h]||"[]");}catch(_){}hist.push([p.status,new Date().toISOString()]);row[h]=JSON.stringify(hist);}else row[headers.indexOf("assignedTo")]=p.assignedTo||"";sh.getRange(rowIndex+1,1,1,headers.length).setValues([row]);return json({ok:true});}if(p.action==="delete"){if(rowIndex<1)throw new Error("Report not found.");sh.deleteRow(rowIndex+1);return json({ok:true});}return json({ok:false,error:"Unknown action"});}catch(err){return json({ok:false,error:String(err)});}finally{try{lock.releaseLock();}catch(_){}}}
